# ── DocScan Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in values before running docker compose up

# ── Ollama / LLM ───────────────────────────────────────────────────────────────
# Which model to use. Recommended options (all free, pulled automatically):
#   qwen2.5:3b    — Best quality at 3B size, beats llama3.2 on doc tasks (default)
#   qwen2.5:1.5b  — Fastest, good for low-RAM servers (< 4 GB free RAM)
#   qwen2.5:7b    — Best accuracy, needs GPU or ≥ 10 GB RAM
#   llama3.2:3b   — Original model (kept for compatibility)
#   mistral:7b    — Great accuracy, slower on CPU
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FAST_MODEL=qwen2.5:1.5b

# Ollama server URL (use service name when running in Docker Compose)
OLLAMA_URL=http://ollama:11434/api/generate

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=app.py

# ── Gunicorn (production server) ───────────────────────────────────────────────
# Number of worker processes (rule of thumb: 2 × CPU cores + 1)
# e.g. for a 4-core server: GUNICORN_WORKERS=9
GUNICORN_WORKERS=4

# ── RAG (Retrieval-Augmented Generation) ───────────────────────────────────────
# Embedding model (runs locally, no API key needed)
#   all-MiniLM-L6-v2       — 22 MB, fastest, great for English bills/invoices (default)
#   all-mpnet-base-v2      — 420 MB, highest accuracy, slower
#   paraphrase-MiniLM-L3-v2 — 17 MB, ultra-fast, slightly lower accuracy
EMBED_MODEL=all-MiniLM-L6-v2

# Where to store the ChromaDB vector index (persists across restarts)
CHROMA_DB_PATH=./chroma_db

# Chunk size in characters (500 is good for bill line items)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# How many chunks to retrieve and send to the LLM per question (3-5 is ideal)
RAG_TOP_K=5

# ── HuggingFace cache (suppress Windows symlink warning on Linux this is not needed) ──
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Optional: pin model cache to a specific path (useful on company servers)
# HF_HOME=/opt/models
